# Copy to .env at the workspace root. Do not put access tokens or passwords here.
# Authenticate separately: az login --tenant <your-tenant-id>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rg-foundry-skills-demo
AZURE_LOCATION=swedencentral
FOUNDRY_RESOURCE_NAME=<your-foundry-resource-name>
FOUNDRY_PROJECT_NAME=skills-demo
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource-name>.services.ai.azure.com/api/projects/skills-demo
FOUNDRY_MODEL=gpt-5.4-mini

# Leave the skill directory empty to use the included sample.
# A relative directory is resolved from the workspace root.
FOUNDRY_SKILL_DIR=
FOUNDRY_SKILL_NAME=engineering-impact-assessment
# Copy the selected skill version printed by notebook 01 before running notebook 02.
FOUNDRY_SKILL_VERSION=
FOUNDRY_TOOLBOX_NAME=engineering-skills-demo
# Leave empty to follow the published Toolbox configuration.
FOUNDRY_TOOLBOX_VERSION=
